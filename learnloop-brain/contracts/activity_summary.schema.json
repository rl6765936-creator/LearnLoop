{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ActivityWatch daily summary (decision 2026-11-24 Q12: app name + category only)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "type", "source", "day", "apps", "content_trust"],
  "properties": {
    "schema_version": {"const": 1},
    "type": {"const": "activity_summary"},
    "source": {
      "type": "object", "additionalProperties": false, "required": ["type", "source_id", "grant_id"],
      "properties": {"type": {"const": "activitywatch"}, "source_id": {"const": "activitywatch"},
                     "grant_id": {"type": "string", "maxLength": 64}}
    },
    "day": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "apps": {
      "type": "array", "maxItems": 200,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["app", "category", "minutes"],
        "properties": {"app": {"type": "string", "minLength": 1, "maxLength": 120},
                       "category": {"type": ["string", "null"], "maxLength": 400},
                       "minutes": {"type": "integer", "minimum": 0, "maximum": 1440}}
      }
    },
    "content_trust": {"const": "untrusted_user_data"}
  }
}
