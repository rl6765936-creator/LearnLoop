{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learnloop/content_analysis/1",
  "title": "ContentAnalysis v1 – what the MODEL may propose about one envelope",
  "description": "Strict: the model can only PROPOSE. It cannot set approval flags, mastery states or permissions – those fields do not exist here on purpose (brain-design §2, 'the model proposes, code decides').",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject",
    "topics",
    "evidence"
  ],
  "properties": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "confidence"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "matched_subject_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "topics": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "confidence",
          "chunk_ids"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "matched_topic_id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "chunk_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "prerequisites": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "maxLength": 120
            }
          },
          "related": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "maxLength": 120
            },
            "description": "spec §13 'related' – other topics of the same subject that are related"
          },
          "skills": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "description": "spec §13 Skill – specific abilities that can be assessed, part of this topic (partOf)"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic",
          "type",
          "authorship",
          "chunk_id"
        ],
        "properties": {
          "topic": {
            "type": "string",
            "maxLength": 120
          },
          "type": {
            "enum": [
              "quiz",
              "explain",
              "apply",
              "transfer",
              "retention",
              "debug",
              "analyze",
              "exposure"
            ]
          },
          "authorship": {
            "enum": [
              "user",
              "ai",
              "user_modified",
              "unknown"
            ]
          },
          "chunk_id": {
            "type": "string"
          },
          "note": {
            "type": "string",
            "maxLength": 500
          },
          "skill": {
            "type": "string",
            "maxLength": 120,
            "description": "optional: the skill of the topic this evidence is about"
          }
        }
      }
    }
  }
}
